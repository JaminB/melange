{
  "spiceVersion": 1,
  "id": "hello-spice",
  "version": "1.0.0",
  "name": "Hello Spice",
  "authors": ["Melange"],
  "description": "A tour of the client Lua API: events, logging, a HUD widget, a world label, an overlay panel, settings, timers and storage.",
  "melange": { "range": ">=0.2.0" },
  "kind": "client-only",
  "defaultEnabled": false,
  "entry": { "client": "client/init.lua" },
  "settings": [
    { "key": "showHud", "type": "bool", "default": true, "label": "Show the HUD widget" },
    { "key": "label", "type": "string", "default": "hello, spice", "label": "World label text" }
  ]
}
