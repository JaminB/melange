{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melange.dev/schema/erg-patch-2.json",
  "title": "Erg patch (erg-patch/2)",
  "description": "An edit that uses level objects, a Survivor twin, a level script, new terrain blocks or a painted surround; a patch without any of them is written as erg-patch/1, and a Melange that only knows /1 refuses a /2 patch by its format. An edit against a pinned base level: the Erg project file, the payload of level.save and what a source map pack ships in src/. It holds only identifiers and the author's own values. The server applies the ops in order and refuses a patch whose base hashes differ.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "stem", "title", "base", "ops"],
  "properties": {
    "format": { "const": "erg-patch/2" },
    "stem": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,48}$",
      "description": "<prefix>_<slug>; never a vanilla level stem."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[ -~]+$" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "source", "sha256"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 79 },
        "source": { "enum": ["game", "pack"] },
        "sha256": { "$ref": "erg-scene-2.schema.json#/$defs/sha256" }
      }
    },
    "kind": { "$ref": "erg-scene-2.schema.json#/$defs/kind" },
    "databank": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only the keys that differ from the base.",
      "properties": {
        "theme": { "$ref": "erg-scene-2.schema.json#/$defs/theme" },
        "timeOfDay": { "enum": ["DAY", "EVENING", "NIGHT"] },
        "materialFile": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "\\.[tT][xX][tT]$",
          "description": "A relative path that must exist in the install."
        },
        "heightmapBase": { "type": "string", "minLength": 1, "maxLength": 64 },
        "heightmapSecond": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "water": { "$ref": "erg-scene-2.schema.json#/$defs/water" },
    "spawns": { "$ref": "erg-scene-2.schema.json#/$defs/spawns" },
    "hmp": { "$ref": "erg-scene-2.schema.json#/$defs/hmp" },
    "ops": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "src"],
            "minProperties": 3,
            "properties": {
              "op": { "const": "set" },
              "src": { "$ref": "erg-scene-2.schema.json#/$defs/index" },
              "name": { "$ref": "#/$defs/label" },
              "resource": { "$ref": "#/$defs/label" },
              "pos": { "$ref": "erg-scene-2.schema.json#/$defs/vec3" },
              "rot": { "$ref": "erg-scene-2.schema.json#/$defs/rot3" },
              "scale": { "$ref": "erg-scene-2.schema.json#/$defs/vec3" },
              "voxelPos": { "$ref": "erg-scene-2.schema.json#/$defs/vec3" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "frame", "detail"],
            "properties": {
              "op": { "const": "add" },
              "frame": {
                "$ref": "erg-scene-2.schema.json#/$defs/index",
                "description": "A folder frame (1x1x1, identity rotation and scale)."
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "resource", "pos"],
                "properties": {
                  "name": { "$ref": "#/$defs/label" },
                  "resource": { "$ref": "#/$defs/label" },
                  "pos": { "$ref": "erg-scene-2.schema.json#/$defs/vec3" },
                  "rot": { "$ref": "erg-scene-2.schema.json#/$defs/rot3" },
                  "scale": { "$ref": "erg-scene-2.schema.json#/$defs/vec3" },
                  "voxelPos": { "$ref": "erg-scene-2.schema.json#/$defs/vec3" }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "src"],
            "properties": { "op": {"const": "remove"}, "src": {"$ref": "erg-scene-2.schema.json#/$defs/index"} }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "frame", "runs"],
            "description": "Terrain: runs of voxel words over the frame's index order, at most 2000 per frame. Accepted only by servers with terrain sculpting. Every word written must be a carve, fill or paint of the base word: bits 8-23 (second-material flags, second material and corner mask) equal to the base word's or zero, unless the server has second-material paint (then bits 8-23 are free; bits 24-31 stay clear).",
            "properties": {
              "op": { "const": "voxels" },
              "frame": {
                "type": "integer",
                "minimum": -64,
                "maximum": 16777216,
                "not": { "const": 0 },
                "description": "A frame of the base, or the tmp id of a frame added by an earlier op."
              },
              "runs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2000,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "prefixItems": [
                    { "type": "integer", "minimum": 0, "maximum": 262143 },
                    { "type": "integer", "minimum": 1, "maximum": 262144 },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16777215,
                      "description": "Bits 24-31 clear; bits 0-1 are 0 (empty) or 3 (solid)."
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "tmp", "parent", "name", "pos", "size"],
            "description": "A new terrain block under the Scene frame (or a frame under it), identity rotation and scale, all voxels empty until voxels ops fill it. pos is its centre in the parent's space: the engine centres a frame's voxels on its position. The name is unused by any frame and holds none of SLIPPY, PERM or TEAMBASE (any case). At most 64.",
            "properties": {
              "op": { "const": "addFrame" },
              "tmp": { "type": "integer", "minimum": -64, "maximum": -1 },
              "parent": { "$ref": "erg-scene-2.schema.json#/$defs/index" },
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,31}$" },
              "pos": { "$ref": "erg-scene-2.schema.json#/$defs/vec3" },
              "size": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "integer", "minimum": 1, "maximum": 32 }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op"],
            "minProperties": 2,
            "description": "Surround painting (hmp.mode paint): runs over the 100x100 cells, row-major.",
            "properties": {
              "op": { "const": "hmp" },
              "heights": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "prefixItems": [
                    { "type": "integer", "minimum": 0, "maximum": 9999 },
                    { "type": "integer", "minimum": 1, "maximum": 10000 },
                    { "type": "number", "minimum": 0, "maximum": 1 }
                  ]
                }
              },
              "blend": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "prefixItems": [
                    { "type": "integer", "minimum": 0, "maximum": 9999 },
                    { "type": "integer", "minimum": 1, "maximum": 10000 },
                    { "type": "integer", "minimum": 0, "maximum": 255 }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "objects": { "$ref": "erg-scene-2.schema.json#/$defs/objects" },
    "script": { "$ref": "erg-scene-2.schema.json#/$defs/script" }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[ -~]+$" }
  }
}
