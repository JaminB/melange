{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melange.dev/schema/erg-scene-2.json",
  "title": "Erg scene (erg-scene/2)",
  "description": "The editable scene of a level that uses level objects, a Survivor twin, a level script, new terrain blocks, a painted surround or trimmed base frames; a scene without any of them is written as erg-scene/1. The editable scene the level service sends to the Erg editor, followed by one binary frame per blob. Positions, scales and voxel coordinates are .xan units as stored; the editor shows world units (x20). Never written into a pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "stem",
    "title",
    "base",
    "registry",
    "databank",
    "water",
    "spawns",
    "hmp",
    "units",
    "frames",
    "details",
    "blobs",
    "objects",
    "script",
    "kind"
  ],
  "properties": {
    "format": { "const": "erg-scene/2" },
    "stem": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[^.]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[ -~]+$" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "source", "file", "sha256"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 79,
          "description": "Registry name, e.g. Multi.DinerMight."
        },
        "source": { "enum": ["game", "pack"] },
        "file": { "type": "string", "minLength": 1, "maxLength": 63, "description": "Level file stem of the base." },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levelType", "themeType", "scripts"],
      "properties": {
        "levelType": { "type": "integer", "minimum": 0, "maximum": 16 },
        "themeType": { "type": "integer", "minimum": 0, "maximum": 11, "description": "5 = the databank's theme." },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[^,]+$" }
        },
        "previewType": { "type": "integer", "minimum": 0, "maximum": 16 }
      }
    },
    "kind": { "$ref": "#/$defs/kind" },
    "databank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "anyOf": [{"const": ""}, {"$ref": "#/$defs/theme"}] },
        "timeOfDay": { "enum": ["", "DAY", "EVENING", "NIGHT"] },
        "materialFile": { "type": "string", "maxLength": 120 },
        "heightmapBase": { "type": "string", "maxLength": 64 },
        "heightmapSecond": { "type": "string", "maxLength": 64 }
      }
    },
    "water": { "$ref": "#/$defs/water" },
    "spawns": { "$ref": "#/$defs/spawns" },
    "hmp": { "$ref": "#/$defs/hmp" },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldPerXan"],
      "properties": { "worldPerXan": {"const": 20} }
    },
    "frames": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent", "name", "pos", "rot", "scale", "size", "voxels", "heightMap", "folder"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -64,
            "maximum": 16777216,
            "description": "An object index of the base; -1..-64 for a new frame."
          },
          "new": {
            "type": "boolean",
            "description": "An added terrain block: under the Scene frame, no rotation, one scale 0.5-4 on every axis, each size 1-32 (the game asserts on 32: new blocks are 1-31), no heightMap (its corner offsets are corners)."
          },
          "corners": {
            "type": "array",
            "items": { "type": "number", "minimum": -64, "maximum": 64 },
            "description": "A new frame's corner offsets in voxels, (X+1)*(Z+1) row by row along x (see erg-patch-2 addFrame.corners); absent means zeros. Only on a new frame."
          },
          "parent": { "anyOf": [{"$ref": "#/$defs/index"}, {"type": "null"}], "description": "null for the root only." },
          "name": { "type": "string", "maxLength": 127 },
          "pos": { "$ref": "#/$defs/vec3" },
          "rot": { "$ref": "#/$defs/rot3" },
          "scale": { "$ref": "#/$defs/vec3" },
          "size": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "description": "X, Y, Z voxels; at most 262144 in all."
          },
          "voxels": {
            "anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}],
            "description": "Blob of X*Y*Z u32 LE words, index (z*X + x)*Y + y."
          },
          "heightMap": {
            "anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}],
            "description": "Blob of (X+1)*(Z+1) f32 LE corner offsets, index z*(X+1) + x."
          },
          "folder": { "type": "boolean", "description": "1x1x1 with identity rotation and scale." }
        }
      }
    },
    "details": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "src", "frame", "name", "resource", "pos", "rot", "scale", "voxelPos", "role"],
        "properties": {
          "id": { "$ref": "#/$defs/index" },
          "src": {
            "anyOf": [{"$ref": "#/$defs/index"}, {"type": "null"}],
            "description": "Object index in the base .xan; null for an added detail."
          },
          "frame": { "$ref": "#/$defs/index" },
          "name": { "type": "string", "maxLength": 127 },
          "resource": { "type": "string", "maxLength": 127 },
          "pos": { "$ref": "#/$defs/vec3" },
          "rot": { "$ref": "#/$defs/rot3" },
          "scale": { "$ref": "#/$defs/vec3" },
          "voxelPos": { "$ref": "#/$defs/vec3" },
          "role": {
            "enum": [
              "scenery",
              "spawn",
              "object",
              "camera",
              "light",
              "emitter",
              "sound",
              "collision",
              "marker",
              "other"
            ],
            "description": "Derived by the server; read-only."
          }
        }
      }
    },
    "blobs": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "frame", "bytes"],
        "properties": {
          "ref": { "$ref": "#/$defs/ref" },
          "kind": {
            "enum": ["voxels", "heightMap", "hmp"],
            "description": "hmp: the surround (hmp.ref), 100x100 f32 heights 0..1 then 100x100 u8 blend (50000 bytes), frame 0."
          },
          "frame": { "type": "integer", "minimum": -64, "maximum": 16777216 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
        }
      }
    },
    "objects": { "$ref": "#/$defs/objects" },
    "script": { "$ref": "#/$defs/script" },
    "trims": {
      "type": "array",
      "maxItems": 4096,
      "description": "Base frames cut down in the build, one entry per frame at most. The scene keeps the whole grid (voxel ops still address it); the built level holds only the kept box, which is what the game's 16-bit cell count sees. Every cell outside the box must be empty, and no detail on the frame may have a voxelPos. A box holding solid cells moves the frame by its offset from the grid's centre and its details and child frames back by as much; an all-empty box keeps the frame where it is (a base frame out of the cell count for one cell).",
      "items": { "$ref": "#/$defs/trim" }
    },
    "previews": {
      "type": "object",
      "description": "level.load only, not part of the saved document: resource name -> preview asset key, for every distinct detail resource in the scene.",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "index": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "trim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "min", "size"],
      "properties": {
        "frame": { "type": "integer", "minimum": 1, "maximum": 16777216, "description": "A frame of the base with voxels." },
        "min": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "description": "The kept box's first cell (x, y, z)." },
        "size": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 1, "maximum": 255 }, "description": "The kept box's size; min + size is within the frame's size." }
      }
    },
    "ref": { "type": "integer", "minimum": 0, "maximum": 16777216 },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
    },
    "rot3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
      "description": "Euler angles in radians."
    },
    "sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xan", "xom"],
      "properties": {
        "xan": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "xom": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "hmp": {
          "anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]
        }
      }
    },
    "theme": {
      "enum": [
        "ARABIAN",
        "WILDWEST",
        "CAMELOT",
        "PREHISTORIC",
        "BUILDING",
        "ARCTIC",
        "ENGLAND",
        "HORROR",
        "LUNAR",
        "PIRATE",
        "WAR"
      ]
    },
    "water": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "anyOf": [{"type": "number", "minimum": -1000, "maximum": 1000}, {"type": "null"}],
          "description": "World units, sea level 0; null keeps the default."
        }
      }
    },
    "spawns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": {"enum": ["random", "knots"]} }
    },
    "hmp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["copy", "none", "flat", "paint"] },
        "ref": { "$ref": "#/$defs/ref", "description": "paint: the blob of the painted surround; copy: the base's surround, when level.load was asked for it." }
      }
    },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "survivor": {
          "type": "boolean",
          "default": false,
          "description": "Also registered as a Survivor map (Multi.<stem>.S)."
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "description": "Metadata only: the text is script.lua next to the project patch (sim/<slug>.lua in a pack).",
      "properties": {
        "present": { "type": "boolean" },
        "sha256": {
          "anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]
        }
      }
    },
    "count": { "type": "integer", "minimum": 1, "maximum": 99 },
    "objects": {
      "type": "array",
      "maxItems": 256,
      "description": "Level objects. Each is a detail added to the level and named by its knot; deleting the detail deletes the object. Knots: CRATE_<n>, TP_<g>_<n> (g = the group), TRIG_<n> (n 0-255, no leading zeros) and minefactory; a detail named telepad is never written. At most 8 telepad groups and 1 mine factory.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["knot", "type", "crate"],
            "properties": {
              "knot": { "type": "string", "pattern": "^CRATE_(0|[1-9][0-9]{0,2})$" },
              "type": { "const": "crate" },
              "crate": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "contents"],
                    "properties": {
                      "kind": { "enum": ["weapon", "utility"] },
                      "contents": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,62}$",
                        "description": "A weapon or utility name of the install (level.objects)."
                      },
                      "count": { "$ref": "#/$defs/count" },
                      "hitpoints": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 25 },
                      "parachute": { "type": "boolean", "default": false }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "amount"],
                    "properties": {
                      "kind": { "const": "health" },
                      "amount": { "type": "integer", "minimum": 1, "maximum": 500 },
                      "hitpoints": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 25 },
                      "parachute": { "type": "boolean", "default": false }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["knot", "type", "group"],
            "properties": {
              "knot": { "type": "string", "pattern": "^TP_[1-8]_(0|[1-9][0-9]{0,2})$" },
              "type": { "const": "telepad" },
              "group": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8,
                "description": "The group in the knot name; a pad sends a worm to another pad of its group."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["knot", "type", "trigger"],
            "properties": {
              "knot": { "type": "string", "pattern": "^TRIG_(0|[1-9][0-9]{0,2})$" },
              "type": { "const": "trigger" },
              "trigger": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0, "maximum": 255 },
                  "radius": { "type": "number", "minimum": 1, "maximum": 1000, "default": 60 },
                  "teamCollect": { "type": "integer", "minimum": 0, "maximum": 8, "default": 0 },
                  "teamDestroy": { "type": "integer", "minimum": 0, "maximum": 8, "default": 4 },
                  "hitpoints": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 1 },
                  "wormCollect": { "type": "boolean", "default": false }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["knot", "type"],
            "properties": {
              "knot": {"const": "minefactory"}, "type": {"const": "minefactory"},
              "factory": {
                "type": "object",
                "additionalProperties": false,
                "description": "Optional settings; a field left out keeps the game's kMineFactoryData value. Written only when one is set.",
                "properties": {
                  "activation": { "type": "integer", "minimum": 0, "maximum": 255, "description": "NumMineActivation (game 20): at a turn start the factory fires when fewer mines than this are in the level, min(activation - mines, 10) of them; 0 never fires." },
                  "inactiveTurns": { "type": "integer", "minimum": 0, "maximum": 255, "description": "NumTurnsInactive (game 7): turn starts the factory waits after it is placed and after each fire." },
                  "schemeMines": { "type": "boolean", "default": true, "description": "false: the scheme's 15 random start mines are not placed (its oil drums are)." },
                  "keepKnot": { "type": "boolean", "default": false, "description": "true: when the factory's drop from its knot hits no land it stays at its knot (Melange 0.13+)." },
                  "launchHeight": { "type": "integer", "minimum": 1, "maximum": 255, "description": "Map units over the factory its mines appear at when it fires (20 when only launchRadius is set), instead of the game's placement over random worms and objects (Melange 0.13+)." },
                  "launchRadius": { "type": "integer", "minimum": 0, "maximum": 255, "description": "Map units round the factory its mines appear within (default 0), so they fall round it (Melange 0.13+)." },
                  "launchers": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": -100000, "maximum": 100000 } }, "description": "1-8 launch points [x, y, z], whole world units: a fire's mines are shared out over them and erupt straight up from within launchRadius of each (Melange 0.13+ of the erg-mcp branch)." },
                  "throw": {
                    "type": "object", "additionalProperties": false, "required": ["maxRange"],
                    "description": "The mines are lobbed out from the launchers (or the factory) to landing points minRange-maxRange map units away and landed by Melange where the flight meets the land (the erg-mcp branch). Fields at their defaults are left out when written.",
                    "properties": {
                      "minRange": { "type": "integer", "minimum": 0, "maximum": 500, "default": 0 },
                      "maxRange": { "type": "integer", "minimum": 1, "maximum": 500 },
                      "apex": { "type": "integer", "minimum": 1, "maximum": 255, "default": 15, "description": "Map units the arc tops out over the higher of its ends." },
                      "pattern": { "type": "string", "enum": ["random", "ring", "targets"], "default": "random" },
                      "avoidWater": { "type": "boolean", "default": true, "description": "A landing point whose ground is under the water is drawn again." },
                      "targets": { "type": "array", "maxItems": 16, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": -100000, "maximum": 100000 } }, "description": "[x, z] whole world units; pattern targets aims targetShare % of a fire's mines within scatter of one of them." },
                      "scatter": { "type": "integer", "minimum": 0, "maximum": 255, "default": 10 },
                      "targetShare": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
                      "volley": { "type": "integer", "minimum": 0, "maximum": 10, "default": 0, "description": "At most this many mines a fire, whatever the engine's min(activation - mines, 10) asked; 0: the engine's count." },
                      "avoidRadius": { "type": "integer", "minimum": 0, "maximum": 50, "default": 0, "description": "Map units a landing point keeps off each avoid line; 0: none." },
                      "avoid": { "type": "array", "maxItems": 8, "items": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": -100000, "maximum": 100000 } } }, "description": "Polylines of [x, z] whole world units (trails, say): a landing point within avoidRadius of one is drawn again. Needs avoidRadius." }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
