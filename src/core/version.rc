#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WUMFIX_VERSION_MAJOR,WUMFIX_VERSION_MINOR,WUMFIX_VERSION_PATCH,0
 PRODUCTVERSION WUMFIX_VERSION_MAJOR,WUMFIX_VERSION_MINOR,WUMFIX_VERSION_PATCH,0
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WUMFix - fixes for Worms Ultimate Mayhem"
            VALUE "FileVersion", WUMFIX_VERSION
            VALUE "ProductName", "WUMFix"
            VALUE "ProductVersion", WUMFIX_VERSION
            VALUE "OriginalFilename", "WUMFix.asi"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
