#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MELANGE_VERSION_MAJOR,MELANGE_VERSION_MINOR,MELANGE_VERSION_PATCH,0
 PRODUCTVERSION MELANGE_VERSION_MAJOR,MELANGE_VERSION_MINOR,MELANGE_VERSION_PATCH,0
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Melange - fixes for Worms Ultimate Mayhem"
            VALUE "FileVersion", MELANGE_VERSION
            VALUE "ProductName", "Melange"
            VALUE "ProductVersion", MELANGE_VERSION
            VALUE "OriginalFilename", "melange.asi"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
