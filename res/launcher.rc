#include <winver.h>
#include <winuser.h>
#include "version.h"

1 ICON "melange.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Melange.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MELANGE_VERSION_MAJOR,MELANGE_VERSION_MINOR,MELANGE_VERSION_PATCH,0
 PRODUCTVERSION MELANGE_VERSION_MAJOR,MELANGE_VERSION_MINOR,MELANGE_VERSION_PATCH,0
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Melange"
            VALUE "FileVersion", MELANGE_VERSION
            VALUE "ProductName", "Melange"
            VALUE "ProductVersion", MELANGE_VERSION
            VALUE "OriginalFilename", "Melange.exe"
            VALUE "InternalName", "Melange"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
